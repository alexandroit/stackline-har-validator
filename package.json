{
  "name": "@stackline/har-validator",
  "version": "1.0.0",
  "description": "Compatibility-first HAR 1.2 validator with maintained packaging, browser builds, and first-party types",
  "type": "commonjs",
  "main": "./lib/promise.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": { "import": "./index.d.mts", "require": "./index.d.cts", "default": "./index.d.ts" },
      "browser": { "import": "./index.mjs", "require": "./lib/promise.js" },
      "import": "./index.mjs",
      "require": "./lib/promise.js",
      "default": "./lib/promise.js"
    },
    "./lib/promise": {
      "types": { "import": "./index.d.mts", "require": "./index.d.cts", "default": "./index.d.ts" },
      "browser": { "import": "./index.mjs", "require": "./lib/promise.js" },
      "import": "./index.mjs",
      "require": "./lib/promise.js",
      "default": "./lib/promise.js"
    },
    "./lib/promise.js": {
      "types": { "import": "./index.d.mts", "require": "./index.d.cts", "default": "./index.d.ts" },
      "browser": { "import": "./index.mjs", "require": "./lib/promise.js" },
      "import": "./index.mjs",
      "require": "./lib/promise.js",
      "default": "./lib/promise.js"
    },
    "./lib/async": {
      "types": { "import": "./esm/async.d.mts", "require": "./lib/async.d.ts", "default": "./lib/async.d.ts" },
      "browser": { "import": "./esm/async.mjs", "require": "./lib/async.js" },
      "import": "./esm/async.mjs",
      "require": "./lib/async.js",
      "default": "./lib/async.js"
    },
    "./lib/async.js": {
      "types": { "import": "./esm/async.d.mts", "require": "./lib/async.d.ts", "default": "./lib/async.d.ts" },
      "browser": { "import": "./esm/async.mjs", "require": "./lib/async.js" },
      "import": "./esm/async.mjs",
      "require": "./lib/async.js",
      "default": "./lib/async.js"
    },
    "./lib/error": {
      "types": { "import": "./esm/error.d.mts", "require": "./lib/error.d.ts", "default": "./lib/error.d.ts" },
      "browser": { "import": "./esm/error.mjs", "require": "./lib/error.js" },
      "import": "./esm/error.mjs",
      "require": "./lib/error.js",
      "default": "./lib/error.js"
    },
    "./lib/error.js": {
      "types": { "import": "./esm/error.d.mts", "require": "./lib/error.d.ts", "default": "./lib/error.d.ts" },
      "browser": { "import": "./esm/error.mjs", "require": "./lib/error.js" },
      "import": "./esm/error.mjs",
      "require": "./lib/error.js",
      "default": "./lib/error.js"
    },
    "./browser": {
      "types": { "import": "./index.d.mts", "require": "./index.d.cts", "default": "./index.d.ts" },
      "import": "./dist/har-validator.browser.mjs",
      "require": "./dist/har-validator.browser.cjs",
      "default": "./dist/har-validator.browser.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "esm",
    "examples",
    "lib",
    "licenses",
    "browser.js",
    "browser.d.ts",
    "index.mjs",
    "index.d.ts",
    "index.d.cts",
    "index.d.mts",
    "CHANGELOG.md",
    "COMPATIBILITY_CONTRACT.md",
    "LICENSE",
    "MIGRATION.md",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint lib esm index.mjs scripts test examples",
    "test:upstream": "node --test test/upstream.test.cjs",
    "test:differential": "node --test test/differential.test.cjs",
    "test:contract": "node --test test/contract.test.cjs test/malformed-security.test.cjs test/stress.test.cjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:esm": "node test/esm.mjs",
    "test:types": "node node_modules/typescript-3-9/bin/tsc -p test/types/tsconfig.legacy.json && node node_modules/typescript/bin/tsc -p test/types/tsconfig.modern.json",
    "test:runtime": "node scripts/check-runtime.mjs",
    "test": "npm run test:upstream && npm run test:differential && npm run test:contract && npm run test:browser && npm run test:esm && npm run test:types && npm run test:runtime",
    "test:coverage": "c8 --all --include='lib/*.js' --check-coverage --lines 95 --functions 95 --branches 85 node --test test/upstream.test.cjs test/differential.test.cjs test/contract.test.cjs test/malformed-security.test.cjs test/stress.test.cjs",
    "test:smoke": "node scripts/smoke-install.mjs",
    "test:registry": "node scripts/smoke-registry.mjs",
    "check:package": "publint && attw --pack .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:release": "node scripts/check-release-metadata.mjs",
    "pack:check": "npm pack --dry-run",
    "artifact:prepare": "node scripts/create-artifact.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=low",
    "audit:signatures": "npm audit signatures",
    "verify": "npm run clean && npm run lint && npm run build && npm test && npm run test:coverage && npm run test:smoke && npm run check:package && npm run pack:check && npm run check:licenses && npm run audit:dependencies && npm run audit:all && npm run audit:signatures",
    "prepack": "npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/alexandroit/stackline-har-validator.git" },
  "homepage": "https://alexandro.net/docs/vanilla/har-validator/",
  "bugs": { "url": "https://github.com/alexandroit/stackline-har-validator/issues" },
  "keywords": ["har", "http-archive", "validator", "json-schema", "browser", "typescript", "stackline"],
  "author": "Stackline Maintainers",
  "contributors": ["Ahmad Nassri"],
  "license": "MIT",
  "engines": { "node": ">=6" },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "ajv": "6.15.0",
    "har-schema": "2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "har-validator-baseline": "npm:har-validator@5.1.5",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "typescript-3-9": "npm:typescript@3.9.10"
  }
}
